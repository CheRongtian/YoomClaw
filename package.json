{
  "name": "yoomclaw",
  "version": "0.1.0",
  "private": true,
  "description": "A mini OpenClaw-like personal AI agent framework",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,electron -c blue,green \"pnpm --dir apps/desktop/renderer run dev\" \"pnpm --filter @yoomclaw/desktop dev\"",
    "dev:renderer": "pnpm --dir apps/desktop/renderer run dev",
    "dev:gateway": "pnpm --filter @yoomclaw/gateway dev",
    "dev:desktop": "pnpm --filter @yoomclaw/desktop dev",
    "dev:all": "pnpm dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @yoomclaw/gateway start",
    "cli": "pnpm --filter @yoomclaw/cli start",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:file-inputs": "tsx scripts/file-input-live.ts",
    "test:file-inputs:ui": "tsx scripts/file-input-ui.mjs",
    "test:file-inputs:history": "node scripts/file-input-history-crosscheck.mjs",
    "test:e2e:ui": "node scripts/full-e2e-ui.mjs",
    "test:e2e:history": "node scripts/file-input-history-crosscheck.mjs",
    "test:e2e:chrome-history": "node scripts/e2e-chrome-history.mjs",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "electron": "^33.4.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
