{
  "name": "yoomclaw",
  "version": "0.2.0",
  "private": true,
  "description": "A mini OpenClaw-like personal AI agent framework",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,electron -c blue,green \"pnpm --dir apps/desktop/renderer run dev\" \"pnpm --filter @yoomclaw/desktop dev\"",
    "dev:renderer": "pnpm --dir apps/desktop/renderer run dev",
    "dev:gateway": "pnpm --filter @yoomclaw/gateway dev",
    "dev:desktop": "pnpm --filter @yoomclaw/desktop dev",
    "dev:all": "pnpm dev",
    "build": "pnpm -r build && pnpm build:computer-helper && pnpm build:desktop-runtime",
    "build:computer-helper": "node scripts/build-computer-helper.mjs",
    "build:computer-fixture": "node scripts/build-computer-fixture.mjs",
    "build:desktop-runtime": "node scripts/build-desktop-runtime.mjs",
    "build:desktop": "pnpm --filter @yoomclaw/desktop-renderer build && pnpm build:computer-helper && pnpm build:desktop-runtime && node scripts/prepare-desktop-app.mjs",
    "package:dir": "pnpm build:desktop && node scripts/prepare-electron-unpacked.mjs mac && electron-builder --dir --mac --arm64 --prepackaged .tmp/electron-unpacked-mac/YoomClaw.app",
    "package:win": "pnpm build:desktop && node scripts/prepare-electron-unpacked.mjs win && electron-builder --win --x64 --prepackaged .tmp/electron-unpacked-win",
    "package:mac": "pnpm build:desktop && node scripts/prepare-electron-unpacked.mjs mac && electron-builder --mac --arm64 --prepackaged .tmp/electron-unpacked-mac/YoomClaw.app",
    "start": "pnpm --filter @yoomclaw/gateway start",
    "cli": "pnpm --filter @yoomclaw/cli start",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:file-inputs": "tsx scripts/file-input-live.ts",
    "test:file-inputs:ui": "tsx scripts/file-input-ui.mjs",
    "test:file-inputs:history": "node web-automation/file-input-history-crosscheck.mjs",
    "test:e2e:ui": "node scripts/full-e2e-ui.mjs",
    "test:e2e:history": "node web-automation/file-input-history-crosscheck.mjs",
    "test:e2e:chrome-history": "node web-automation/e2e-chrome-history.mjs",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "build": {
    "appId": "com.yoomclaw.desktop",
    "productName": "YoomClaw",
    "directories": {
      "app": ".tmp/desktop-app",
      "output": "release"
    },
    "files": [
      "src/**/*",
      "renderer/dist/**/*",
      "runtime/**/*",
      "assets/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "packages/gateway/pdf_extract.py",
        "to": "runtime-helpers/pdf_extract.py"
      },
      {
        "from": "packages/gateway/document_extract.py",
        "to": "runtime-helpers/document_extract.py"
      }
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "apps/desktop/assets/app-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        },
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "apps/desktop/assets/app-icon.png",
      "identity": null,
      "hardenedRuntime": false
    },
    "publish": {
      "provider": "github",
      "owner": "Alex-Wang-88",
      "repo": "YoomClaw",
      "releaseType": "release"
    }
  }
}
