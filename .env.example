# ===== YoomClaw 环境变量示例 =====

# 积墨 AI API 配置
JIMO_API_BASE_URL=https://jimoai-bot-api.xiaohuodui.cn
JIMO_SHARE_ID=your_share_id_here
JIMO_AUTHORIZATION=your_authorization_token_here

# Gateway 配置
GATEWAY_PORT=18789
GATEWAY_HOST=127.0.0.1
YOOMCLAW_PYTHON=

# Hermes Mode 运行时
YOOMCLAW_AGENT_MODE=hermes
YOOMCLAW_PROMPT_MODE=provider
YOOMCLAW_AUTO_MEMORY_REVIEW=false
YOOMCLAW_DATA_DIR=
YOOMCLAW_WORKSPACE=
YOOMCLAW_BROWSER_CDP_URL=http://127.0.0.1:9222
# confirm | workspace-auto | full-access
YOOMCLAW_SAFETY_MODE=workspace-auto
YOOMCLAW_TOOLSETS=coding,memory,skills,browser,vision,planning,web,execution,orchestration
# MCP / computer are opt-in toolsets; append mcp or computer when configured.

# Web search / MCP adapters are optional. Tokens are read only from environment variables.
YOOMCLAW_SEARCH_URL=
YOOMCLAW_SEARCH_TOKEN=
YOOMCLAW_MCP_URL=
YOOMCLAW_MCP_TOKEN=
YOOMCLAW_MCP_SERVER_NAME=

# 可选：独立的积墨识图 / OCR 机器人
JIMO_VISION_API_BASE_URL=https://jimoai-bot-api.xiaohuodui.cn
JIMO_VISION_SHARE_ID=
JIMO_VISION_AUTHORIZATION=

# 图片先上传到自建图床，再把图床返回的 HTTPS URL 交给识图机器人
IMAGE_HOST_UPLOAD_URL=https://yunbloom.cn/img/api/upload
# 二选一：直接填写 token，或填写本地 token 文件路径
IMAGE_HOST_UPLOAD_TOKEN=
IMAGE_HOST_UPLOAD_TOKEN_FILE=

# 默认模型（预留）
DEFAULT_MODEL=jimo-default
