# ===== YoomClaw macOS 环境变量示例 =====

# 积墨 AI API 配置
JIMO_API_BASE_URL=https://jimoai-bot-api.xiaohuodui.cn
JIMO_SHARE_ID=your_share_id_here
JIMO_AUTHORIZATION=your_authorization_token_here

# Gateway 配置；18789 通常由 OpenClaw 使用
GATEWAY_PORT=18790
GATEWAY_HOST=127.0.0.1
YOOMCLAW_PYTHON=python3

# 主 Agent 与本地运行时
DEFAULT_MODEL=gpt-5.6-luna
YOOMCLAW_PROMPT_MODE=provider
YOOMCLAW_AUTO_MEMORY_REVIEW=false
YOOMCLAW_DATA_DIR=
YOOMCLAW_WORKSPACE=
YOOMCLAW_BROWSER_CDP_URL=http://127.0.0.1:9222
YOOMCLAW_COMPUTER_ENABLED=false
# confirm | workspace-auto | full-access
YOOMCLAW_SAFETY_MODE=workspace-auto
YOOMCLAW_TOOLSETS=coding,memory,skills,browser,planning,web,execution,orchestration
# MCP / computer 为可选 Toolset，配置完成后追加 mcp 或 computer。

# Web 搜索与 MCP 适配器（可选）
YOOMCLAW_SEARCH_URL=
YOOMCLAW_SEARCH_TOKEN=
YOOMCLAW_MCP_URL=
YOOMCLAW_MCP_TOKEN=
YOOMCLAW_MCP_SERVER_NAME=

# 图片需要先上传到图床，再以 HTTPS URL 交给主 Agent
IMAGE_HOST_UPLOAD_URL=https://yunbloom.cn/img/api/upload
# 二选一：直接填写 token，或填写 macOS 本地 token 文件路径
IMAGE_HOST_UPLOAD_TOKEN=
IMAGE_HOST_UPLOAD_TOKEN_FILE=
